# ===== Application =====
APP_NAME=MedAI App
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-random-string

# ===== Database =====
DATABASE_URL=postgresql://medai:changeme@db:5432/medai
DB_HOST=db
DB_PORT=5432
DB_NAME=medai
DB_USER=medai
DB_PASSWORD=changeme

# ===== Authentication =====
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000

# ===== Email (SMTP) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@example.com

# ===== Encryption =====
ENCRYPTION_KEY=change-me-base64-key
KMS_KEY_ID=  # AWS KMS key for field-level encryption

# ===== Redis (optional) =====
REDIS_URL=redis://redis:6379/0

# ===== Logging =====
LOG_LEVEL=INFO
REACT_APP_SKIP_AUTH=changeme
SEED_USER_PASSWORD=changeme

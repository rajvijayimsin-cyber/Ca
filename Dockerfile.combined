# Combined single-container build for carenest
# Runs backend (uvicorn :8000) + frontend (nginx :8080) in one container
# Compatible with: local Docker, AWS App Runner, Cloud Run

# ── Stage 1: Build React frontend with Vite (cached node_modules) ──
FROM node:18-alpine AS frontend-deps
WORKDIR /app/frontend
# Copy ONLY package files first — this layer is cached until package.json changes
COPY frontend/package*.json ./
# Install dependencies (cached layer — ~2 min with Vite vs ~12 min with CRA)
# `|| echo skipped` used to hide a failed install; the build then failed too
# and was itself swallowed, so the image shipped a placeholder page.
RUN npm install --legacy-peer-deps

FROM node:18-alpine AS frontend-build
WORKDIR /app/frontend
# Copy cached node_modules from deps stage
COPY --from=frontend-deps /app/frontend/node_modules ./node_modules
COPY --from=frontend-deps /app/frontend/package*.json ./
# Copy source files (this layer changes every build, but node_modules are cached)
COPY frontend/ ./
# Ensure API URL is empty so frontend uses relative paths (nginx proxies /api to backend)
ENV VITE_API_URL=
# Skip-auth build flag — when true, the generated PrivateRoute lets every
# request through without checking the session. Used for Playwright tests
# and demo mode. Default ON for now while auth is being hardened; set
# REACT_APP_SKIP_AUTH=false at build time to re-enable the guard.
ARG REACT_APP_SKIP_AUTH=true
ENV REACT_APP_SKIP_AUTH=${REACT_APP_SKIP_AUTH}
# Build with Vite — much faster than CRA (~30s vs ~3 min)
# No `|| fallback`. A failed frontend build used to write a one-page stub
# saying "API Backend Running" and the deploy still reported PASSED, so a
# customer opened their app and saw a placeholder. If the build fails, the
# image must fail to build.
RUN npm run build
# The app is the point: an empty or missing bundle is a failed build, whatever
# the exit code said.
RUN test -s /app/frontend/build/index.html     && test -d /app/frontend/build/assets     || (echo "frontend build produced no bundle" && exit 1)

# ── Stage 2: Production image ──
FROM python:3.11-slim

# Install nginx + supervisor for multi-process management
RUN apt-get update && \
    apt-get install -y --no-install-recommends nginx supervisor curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY backend/requirements.txt ./requirements.txt
# Install with fallback to loose version if pinned version unavailable
RUN pip install --no-cache-dir -r requirements.txt || \
    pip install --no-cache-dir $(grep -v '==' requirements.txt | grep -v '^#' | grep -v '^$') || \
    pip install --no-cache-dir fastapi uvicorn sqlalchemy pydantic python-jose passlib bcrypt python-multipart alembic psycopg2-binary email-validator slowapi

# Copy backend code into /app/backend/
COPY backend/ ./backend/
# Ensure backend is importable as a package AND as a module (symlink for flexibility)
RUN touch /app/backend/__init__.py && \
    ln -sf /app/backend /app/app

# Copy built frontend static files
COPY --from=frontend-build /app/frontend/build /var/www/html
# Ensure at least a minimal index.html exists
RUN test -f /var/www/html/index.html || \
    echo '<!DOCTYPE html><html><head><title>carenest</title></head><body><h1>carenest API</h1><p>Backend running. Frontend not built.</p></body></html>' > /var/www/html/index.html

# Copy deploy configs
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/supervisord.conf /etc/supervisor/conf.d/app.conf

# Remove default nginx site and set up directories
RUN rm -f /etc/nginx/sites-enabled/default 2>/dev/null || true; \
    mkdir -p /var/log/supervisor /var/run/nginx && \
    chmod 777 /app/backend

# Database migration + admin seed script
COPY deploy/startup.sh /app/startup.sh
RUN chmod +x /app/startup.sh

EXPOSE 8080

HEALTHCHECK --interval=20s --timeout=10s --start-period=60s --retries=5 \
    CMD curl -sf http://localhost:8080/health || curl -sf http://localhost:8000/health || exit 1

CMD ["/app/startup.sh"]

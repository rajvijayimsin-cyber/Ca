# Development defaults — generated by MedAI Builder
# Works with docker-compose out of the box. Change for production!

# ===== Application =====
APP_NAME=MedAI App
APP_ENV=development
DEBUG=true
SECRET_KEY=dev-secret-change-in-production

# ===== Database =====
DATABASE_URL=postgresql://medai:changeme@db:5432/medai
DB_HOST=db
DB_PORT=5432
DB_NAME=medai
DB_USER=medai
DB_PASSWORD=changeme

# ===== Authentication =====
JWT_SECRET_KEY=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ===== Encryption =====
ENCRYPTION_KEY=dev-encryption-key-change-in-prod

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== Logging =====
LOG_LEVEL=DEBUG
